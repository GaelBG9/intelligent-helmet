# Copy this file to .env and fill in your values. .env is ignored by git.

# MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=Projet_casque

# The Things Network (MQTT integration)
TTN_HOST=eu1.cloud.thethings.network
TTN_APP_ID=your-ttn-application-id
TTN_API_KEY=NNSXS.your-api-key
TTN_DEVICE_ID=arduino-mkr-1310-1

# Twilio WhatsApp alerts (optional, leave empty to disable)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ALERT_WHATSAPP_TO=whatsapp:+33600000000
